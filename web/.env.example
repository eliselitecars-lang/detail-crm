# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the public anon key belongs here; never put the service_role key or
# any Stripe/Twilio/Resend secret in a VITE_ variable (they ship to browsers).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
