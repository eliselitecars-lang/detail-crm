# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the public anon key belongs here; never put the service_role key or
# any Stripe/Twilio/Resend secret in a VITE_ variable (they ship to browsers).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: who operates this deployment, shown on /privacy and /terms. Leave
# blank and the pages say "the operator of this service" (nothing is made up).
# VITE_LEGAL_COUNTRY reads after "governed by the laws of", e.g.
# "the State of Delaware, United States". VITE_LEGAL_ADDRESS may use \n for
# line breaks.
VITE_LEGAL_ENTITY_NAME=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_COUNTRY=
VITE_LEGAL_ADDRESS=
