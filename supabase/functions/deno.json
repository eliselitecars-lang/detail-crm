{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.117.2",
    "stripe": "npm:stripe@22.6.2",
    "zod": "npm:zod@4.6.5",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@std/testing": "jsr:@std/testing@1.0.21",
    "@std/toml": "jsr:@std/toml@1.0.11"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true
  },
  "lock": false,
  "nodeModulesDir": "none",
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "exclude": ["README.md"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "eqeqeq",
        "no-console",
        "no-eval",
        "no-throw-literal",
        "no-sync-fn-in-async-fn",
        "no-non-null-assertion",
        "explicit-module-boundary-types"
      ]
    }
  },
  "test": {
    "include": ["**/*_test.ts"]
  },
  "tasks": {
    "fmt": "deno fmt",
    "check": "deno check **/*.ts",
    "lint": "deno lint",
    "test": "deno test --allow-env --allow-read=.. --no-prompt",
    "ci": "deno fmt --check && deno lint && deno check **/*.ts && deno test --allow-env --allow-read=.. --no-prompt"
  }
}
