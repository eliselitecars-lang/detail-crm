# Local secrets for `supabase functions serve --env-file supabase/functions/.env.local`.
# Copy to .env.local (git-ignored) and fill in TEST-mode values. In hosted
# projects set them with `supabase secrets set` (see README.md). SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Stripe (platform account; test mode keys locally)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-connect-to ...` locally, or the Connect endpoint in the Dashboard
STRIPE_WEBHOOK_SECRET=
# Optional platform application fee in basis points (0-10000); empty = 0
PLATFORM_FEE_BPS=
# Shop subscription billing (docs/BILLING.md): the PLATFORM endpoint's secret
# for billing-webhook, e.g. from `stripe listen --events <billing events>
# --forward-to localhost:54321/functions/v1/billing-webhook`. Only while billing is on.
STRIPE_BILLING_WEBHOOK_SECRET=
# Optional: "true" = Stripe Tax on shop subscription Checkout (set up Stripe Tax first)
BILLING_AUTOMATIC_TAX=

# Twilio (platform account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend
RESEND_API_KEY=
# "Detail CRM <notifications@your-verified-domain>"
EMAIL_FROM=

# Web app base URL used in links and as the allowed CORS origin
APP_BASE_URL=http://localhost:5173
# Shared secret pg_cron sends as x-cron-secret (at least 24 characters)
CRON_SECRET=

# Optional: extra comma-separated CORS origins (exact origins, no paths)
CORS_ALLOWED_ORIGINS=
# Optional: public functions base URL when exposing local dev through a tunnel
# (Stripe/Twilio signatures are validated against it)
FUNCTIONS_PUBLIC_URL=

# Optional: APNs push notifications for the iPhone app (push function). Set
# all four or none (none = no pushes). Key: developer.apple.com -> Keys ->
# Apple Push Notifications service; the .p8 contents may use \n line breaks.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
# The app's bundle id
APNS_TOPIC=

# Optional feature flags (unset = off). Self-serve SMS numbers need a Twilio
# account that can buy numbers and submit toll-free verifications; 10DLC
# registration also needs an approved ISV account and its primary Trust Hub
# customer profile (BU...).
SMS_PROVISIONING_ENABLED=
TWILIO_ISV_ENABLED=
TWILIO_PRIMARY_CUSTOMER_PROFILE_SID=

# LOCAL real-stack harness ONLY (scripts/stack/up.sh sets these in the
# generated .env.stack): point Stripe/Twilio/Resend at local simulators.
# Never set in hosted projects (unset = the real provider hosts).
# STRIPE_API_BASE=http://host.docker.internal:12111
# TWILIO_API_BASE=http://host.docker.internal:12120/2010-04-01
# RESEND_API_BASE=http://host.docker.internal:12120
