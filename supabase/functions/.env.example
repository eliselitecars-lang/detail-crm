# Local secrets for `supabase functions serve --env-file supabase/functions/.env.local`.
# Copy to .env.local (git-ignored) and fill in TEST-mode values. In hosted
# projects set them with `supabase secrets set` (see README.md). SUPABASE_URL,
# SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected automatically.

# Stripe (platform account; test mode keys locally)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-connect-to ...` locally, or the Connect endpoint in the Dashboard
STRIPE_WEBHOOK_SECRET=
# Optional platform application fee in basis points (0-10000); empty = 0
PLATFORM_FEE_BPS=

# Twilio (platform account)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Resend
RESEND_API_KEY=
# "Detail CRM <notifications@your-verified-domain>"
EMAIL_FROM=

# Web app base URL used in links and as the allowed CORS origin
APP_BASE_URL=http://localhost:5173
# Shared secret pg_cron sends as x-cron-secret (at least 24 characters)
CRON_SECRET=

# Optional: extra comma-separated CORS origins (exact origins, no paths)
CORS_ALLOWED_ORIGINS=
# Optional: public functions base URL when exposing local dev through a tunnel
# (Stripe/Twilio signatures are validated against it)
FUNCTIONS_PUBLIC_URL=
