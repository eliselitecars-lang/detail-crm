  perform tests.fx_set('rv_b', v_id);
  -- 03-06 00:00-01:00Z = Thu 03-06 09:00-10:00 JST (today in Tokyo at p_now)
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end)
    values (v_b, tests.fx('rc_alice_b'), tests.fx('rv_b'), 'scheduled', '2025-03-06 00:00+00', '2025-03-06 01:00+00')
