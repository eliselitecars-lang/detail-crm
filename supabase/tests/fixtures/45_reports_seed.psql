-- Shared fixture for the 45_* report / dashboard / search tests. Include with
--   \ir fixtures/45_reports_seed.psql
-- Runs as the superuser with FIXED timestamps only (never now()), so every
-- expected number in the tests is hand-computable. Reference instant used by
-- the tests: p_now = 2025-03-05 16:00 UTC
--   shop A  America/Chicago  -> Wed 2025-03-05 10:00 CST (UTC-6).
--           DST starts Sun 2025-03-09 02:00, so this week is
--           [Mon 03-03 00:00 CST = 06:00Z, Mon 03-10 00:00 CDT = 05:00Z)
--           and March is [03-01 06:00Z, 04-01 05:00Z).
--   shop B  Asia/Tokyo (UTC+9) -> Thu 2025-03-06 01:00 JST.
--
-- Keys (tests.fx):
--   shops    rshop_a, rshop_b
--   users    ru_owner_a ru_admin_a ru_manager_a ru_tech1_a ru_tech2_a
--            ru_owner_b ru_tech_b ru_outsider
--   members  rm_owner_a rm_admin_a rm_manager_a rm_tech1_a rm_tech2_a
--            rm_tech3_a (inactive, 2h in March) rm_tech4_a (inactive, no activity)
--            rm_owner_b rm_tech_b
--   shop A   services rs_full (Exterior), rs_ceramic (Protection), rs_pet (addon, no category)
--            customers rc_alice rc_bob rc_ann rc_larry rc_pct rc_annie
--            vehicles  rv_civic (Alice) rv_f150 (Bob) rv_tesla (Ann)
--            jobs      rj_1001 .. rj_1012 (numbers 1001..1012 in that order)
--            quotes    rq_1001 .. rq_1005
--            invoices  ri_1001 .. ri_1009
--   shop B   rc_alice_b, rv_b, rj_b1
--
-- Shop A data (tax 8% = 800 bps)
-- Jobs (UTC; local CST = UTC-6 before 03-09):
--   1001 Alice completed 02-20 18:00 (Feb)   FD 20000                       total 21600  [tech1]
--   1002 Alice completed 03-03 20:00         FD 20000 (s0) + Pet 5000 non-tax (s1)
--                                            + custom "Headlight Polish" 1500×2 (s2), fixed discount 2900
--        subtotal 28000, taxable 23000, taxable discount round(2900·23000/28000)=2382,
--        tax round(20618·0.08)=1649, total 28000−2900+1649 = 26749, pre-tax 25100 [tech1, tech2]
--   1003 Bob   completed 03-05 05:30 (= 03-04 23:30 CST) Ceramic 100000   total 108000 [tech1, tech2, manager]
--   1004 Ann   confirmed   03-05 17:00-19:00                                           [tech2]
--   1005 Alice in_progress 03-05 14:00-15:30                                           [tech1]
--   1006 Bob   scheduled   03-06 01:00-02:00 (= 03-05 19:00 CST: today locally)
--   1007 Alice scheduled   03-06 06:30-07:30 (= 03-06 00:30 CST: tomorrow)             [tech1]
--   1008 Ann   cancelled   03-05 20:00-21:00
--   1009 Larry requested   online booking, unscheduled
--   1010 Bob   requested   staff, 03-11 15:00-16:00
--   1011 Ann   scheduled   03-10 04:00-05:00 (= Sun 03-09 23:00 CDT: this week)
--   1012 Bob   scheduled   03-10 05:00-06:00 (= Mon 03-10 00:00 CDT: next week)
-- Quotes: 1001 sent (no expiry), 1002 viewed valid_until 03-04 (expired by date),
--   1003 viewed valid_until 03-05 (valid through 03-06 06:00Z), 1004 draft, 1005 approved
-- Invoices:
--   1001 J1001 paid      21600
--   1002 J1002 paid      26749 (deposit 5000 + 21749)
--   1003 J1003 partial  108000 − 50000 = 58000, due 03-19 02:00Z (not overdue)
--   1004 Ann   partial   16200 − 6200 = 10000, due 2024-12-15 18:00Z
--   1005 Bob   open      30000, due 2024-10-31 17:00Z
--   1006 Alice open       7500, due 2025-02-03 18:00Z
--   1007 Alice open       4000, due 2025-02-02 18:00Z
--   1008 Bob   draft      9000
--   1009 Ann   void      12345
-- Payments (received unless noted; local date in CST/CDT):
--   P1  I1001 card  21600 tip 2000                     2025-02-20 19:00Z  Feb 20
--   P2  I1002 cash   5000 deposit                      2025-03-01 05:30Z  Feb 28 23:30
--   P3  I1002 card  21749 tip 3000                     2025-03-03 21:00Z  Mar 3
--   P4  I1003 card  50000                              2025-03-05 03:00Z  Mar 4 21:00
--   P5  I1004 cash   6200                              2024-12-10 18:00Z  Dec 10
--   P9  J1004 card  10000 deposit, refunded 4000       2025-03-05 15:00Z  Mar 5
--   P10 J1006 cash   3000 tip 500 deposit, refunded 3500 (all) 2025-03-05 12:00Z  Mar 5
--   P11 J1007 card   2000 tip 1000 deposit, refunded 2500     2025-03-06 05:59Z  Mar 5 23:59
--   P14 J1011 cash   1000 deposit                      2025-03-10 04:30Z  Sun Mar 9 23:30 CDT
--   P15 J1012 cash   2000 deposit                      2025-03-10 05:30Z  Mon Mar 10 00:30 CDT
--   P12 J1010 card   9999 PENDING;  P13 I1005 check 7777 FAILED
-- Time entries: see the block below.
do $seed$
declare
  v_a   uuid;
  v_b   uuid;
  v_id  uuid;
  v_cat_ext  uuid;
  v_cat_pro  uuid;
  v_void     uuid;
begin
  v_a := tests.fx_set('rshop_a', tests.make_shop('owner-ra@test.local', 'report-a', 'Report Shop A', 'America/Chicago'));
  v_b := tests.fx_set('rshop_b', tests.make_shop('owner-rb@test.local', 'report-b', 'Report Shop B', 'Asia/Tokyo'));
  update public.shops set tax_rate_bps = 800 where id = v_a;

  perform tests.fx_set('ru_owner_a', tests.user_id('owner-ra@test.local'));
  perform tests.fx_set('ru_owner_b', tests.user_id('owner-rb@test.local'));
  perform tests.fx_set('rm_owner_a', (select id from public.shop_members where shop_id = v_a and role = 'owner'));
  perform tests.fx_set('rm_owner_b', (select id from public.shop_members where shop_id = v_b and role = 'owner'));
  perform tests.fx_set('rm_admin_a',   tests.add_member(v_a, 'admin-ra@test.local', 'admin'));
  perform tests.fx_set('rm_manager_a', tests.add_member(v_a, 'manager-ra@test.local', 'manager'));
  perform tests.fx_set('rm_tech1_a',   tests.add_member(v_a, 'tech1-ra@test.local', 'technician'));
  perform tests.fx_set('rm_tech2_a',   tests.add_member(v_a, 'tech2-ra@test.local', 'technician'));
  perform tests.fx_set('rm_tech3_a',   tests.add_member(v_a, 'tech3-ra@test.local', 'technician', false));
  perform tests.fx_set('rm_tech4_a',   tests.add_member(v_a, 'tech4-ra@test.local', 'technician', false));
  perform tests.fx_set('rm_tech_b',    tests.add_member(v_b, 'tech-rb@test.local', 'technician'));
  perform tests.fx_set('ru_admin_a',   tests.user_id('admin-ra@test.local'));
  perform tests.fx_set('ru_manager_a', tests.user_id('manager-ra@test.local'));
  perform tests.fx_set('ru_tech1_a',   tests.user_id('tech1-ra@test.local'));
  perform tests.fx_set('ru_tech2_a',   tests.user_id('tech2-ra@test.local'));
  perform tests.fx_set('ru_tech_b',    tests.user_id('tech-rb@test.local'));
  perform tests.fx_set('ru_outsider',  tests.create_user('outsider-r@test.local'));

  insert into public.member_compensation (shop_id, member_id, hourly_rate_cents, commission_bps) values
    (v_a, tests.fx('rm_tech1_a'),   2000, 1000),
    (v_a, tests.fx('rm_tech2_a'),   2525,  750),
    (v_a, tests.fx('rm_manager_a'), 3000,    0);

  -- ------------------------------------------------------------ catalog
  insert into public.service_categories (shop_id, name, sort) values (v_a, 'Exterior', 1) returning id into v_cat_ext;
  insert into public.service_categories (shop_id, name, sort) values (v_a, 'Protection', 2) returning id into v_cat_pro;
  insert into public.services (shop_id, category_id, name, kind) values (v_a, v_cat_ext, 'Full Detail', 'service')
    returning id into v_id;
  perform tests.fx_set('rs_full', v_id);
  insert into public.services (shop_id, category_id, name, kind) values (v_a, v_cat_pro, 'Ceramic Coating', 'service')
    returning id into v_id;
  perform tests.fx_set('rs_ceramic', v_id);
  insert into public.services (shop_id, name, kind, taxable) values (v_a, 'Pet Hair Removal', 'addon', false)
    returning id into v_id;
  perform tests.fx_set('rs_pet', v_id);
  perform tests.fx_set('rcat_ext', v_cat_ext);
  perform tests.fx_set('rcat_pro', v_cat_pro);

  -- ------------------------------------------------------------ customers / vehicles
  insert into public.customers (shop_id, first_name, last_name, email, phone, created_at)
    values (v_a, 'Alice', 'Anders', 'alice@example.com', '+12055550101', '2024-11-01 15:00+00') returning id into v_id;
  perform tests.fx_set('rc_alice', v_id);
  insert into public.customers (shop_id, first_name, last_name, email, phone, created_at)
    values (v_a, 'Bob', 'Brown', 'bob@example.com', '+12055550102', '2025-02-25 15:00+00') returning id into v_id;
  perform tests.fx_set('rc_bob', v_id);
  insert into public.customers (shop_id, first_name, last_name, phone, created_at)
    values (v_a, 'Ann_Marie', 'Smith', '+12055550103', '2024-11-15 15:00+00') returning id into v_id;
  perform tests.fx_set('rc_ann', v_id);
  insert into public.customers (shop_id, first_name, last_name, lifecycle, source, created_at)
    values (v_a, 'Larry', 'Lead', 'lead', 'online_booking', '2025-03-04 18:00+00') returning id into v_id;
  perform tests.fx_set('rc_larry', v_id);
  -- 04-01 04:30Z = Mar 31 23:30 CDT -> created in March
  insert into public.customers (shop_id, company, created_at)
    values (v_a, '100% Detail Co', '2025-04-01 04:30+00') returning id into v_id;
  perform tests.fx_set('rc_pct', v_id);
  -- 04-01 05:30Z = Apr 1 00:30 CDT -> created in April
  insert into public.customers (shop_id, first_name, last_name, created_at)
    values (v_a, 'Annie', 'Hall', '2025-04-01 05:30+00') returning id into v_id;
  perform tests.fx_set('rc_annie', v_id);

  insert into public.vehicles (shop_id, customer_id, year, make, model, license_plate, vin)
    values (v_a, tests.fx('rc_alice'), 2021, 'Honda', 'Civic', 'ABC123', '1HGCM82633A004352') returning id into v_id;
  perform tests.fx_set('rv_civic', v_id);
  insert into public.vehicles (shop_id, customer_id, year, make, model, license_plate)
    values (v_a, tests.fx('rc_bob'), 2019, 'Ford', 'F-150', 'TRK900') returning id into v_id;
  perform tests.fx_set('rv_f150', v_id);
  insert into public.vehicles (shop_id, customer_id, year, make, model)
    values (v_a, tests.fx('rc_ann'), 2020, 'Tesla', 'Model 3') returning id into v_id;
  perform tests.fx_set('rv_tesla', v_id);

  -- ------------------------------------------------------------ jobs (numbers 1001..1012 in order)
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end, completed_at)
    values (v_a, tests.fx('rc_alice'), tests.fx('rv_civic'), 'completed',
            '2025-02-20 15:00+00', '2025-02-20 17:00+00', '2025-02-20 18:00+00') returning id into v_id;
  perform tests.fx_set('rj_1001', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end, completed_at,
                           discount_kind, discount_value)
    values (v_a, tests.fx('rc_alice'), tests.fx('rv_civic'), 'completed',
            '2025-03-03 16:00+00', '2025-03-03 19:00+00', '2025-03-03 20:00+00', 'fixed', 2900) returning id into v_id;
  perform tests.fx_set('rj_1002', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end, completed_at)
    values (v_a, tests.fx('rc_bob'), tests.fx('rv_f150'), 'completed',
            '2025-03-04 23:00+00', '2025-03-05 05:00+00', '2025-03-05 05:30+00') returning id into v_id;
  perform tests.fx_set('rj_1003', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end, confirmed_at)
    values (v_a, tests.fx('rc_ann'), tests.fx('rv_tesla'), 'confirmed',
            '2025-03-05 17:00+00', '2025-03-05 19:00+00', '2025-03-04 12:00+00') returning id into v_id;
  perform tests.fx_set('rj_1004', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end, started_at)
    values (v_a, tests.fx('rc_alice'), tests.fx('rv_civic'), 'in_progress',
            '2025-03-05 14:00+00', '2025-03-05 15:30+00', '2025-03-05 14:05+00') returning id into v_id;
  perform tests.fx_set('rj_1005', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end)
    values (v_a, tests.fx('rc_bob'), tests.fx('rv_f150'), 'scheduled',
            '2025-03-06 01:00+00', '2025-03-06 02:00+00') returning id into v_id;
  perform tests.fx_set('rj_1006', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end)
    values (v_a, tests.fx('rc_alice'), tests.fx('rv_civic'), 'scheduled',
            '2025-03-06 06:30+00', '2025-03-06 07:30+00') returning id into v_id;
  perform tests.fx_set('rj_1007', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end, cancelled_at, cancel_reason)
    values (v_a, tests.fx('rc_ann'), tests.fx('rv_tesla'), 'cancelled',
            '2025-03-05 20:00+00', '2025-03-05 21:00+00', '2025-03-04 09:00+00', 'Rain') returning id into v_id;
  perform tests.fx_set('rj_1008', v_id);
  insert into public.jobs (shop_id, customer_id, status, source)
    values (v_a, tests.fx('rc_larry'), 'requested', 'online_booking') returning id into v_id;
  perform tests.fx_set('rj_1009', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, source, scheduled_start, scheduled_end)
    values (v_a, tests.fx('rc_bob'), tests.fx('rv_f150'), 'requested', 'staff',
            '2025-03-11 15:00+00', '2025-03-11 16:00+00') returning id into v_id;
  perform tests.fx_set('rj_1010', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end)
    values (v_a, tests.fx('rc_ann'), tests.fx('rv_tesla'), 'scheduled',
            '2025-03-10 04:00+00', '2025-03-10 05:00+00') returning id into v_id;
  perform tests.fx_set('rj_1011', v_id);
  insert into public.jobs (shop_id, customer_id, vehicle_id, status, scheduled_start, scheduled_end)
    values (v_a, tests.fx('rc_bob'), tests.fx('rv_f150'), 'scheduled',
            '2025-03-10 05:00+00', '2025-03-10 06:00+00') returning id into v_id;
  perform tests.fx_set('rj_1012', v_id);

  insert into public.job_line_items (shop_id, job_id, service_id, name, unit_price_cents, taxable, sort) values
    (v_a, tests.fx('rj_1001'), tests.fx('rs_full'),    'Full Detail',       20000, true,  0),
    (v_a, tests.fx('rj_1002'), tests.fx('rs_full'),    'Full Detail',       20000, true,  0),
    (v_a, tests.fx('rj_1002'), tests.fx('rs_pet'),     'Pet Hair Removal',   5000, false, 1),
    (v_a, tests.fx('rj_1003'), tests.fx('rs_ceramic'), 'Ceramic Coating',  100000, true,  0),
    (v_a, tests.fx('rj_1004'), tests.fx('rs_full'),    'Full Detail',       20000, true,  0),
    (v_a, tests.fx('rj_1005'), tests.fx('rs_full'),    'Full Detail',       20000, true,  0);
  insert into public.job_line_items (shop_id, job_id, name, quantity, unit_price_cents, taxable, sort) values
    (v_a, tests.fx('rj_1002'), 'Headlight Polish', 2, 1500, true, 2);

  insert into public.job_assignments (shop_id, job_id, member_id, created_at) values
    (v_a, tests.fx('rj_1001'), tests.fx('rm_tech1_a'),   '2025-02-01 10:00+00'),
    (v_a, tests.fx('rj_1002'), tests.fx('rm_tech1_a'),   '2025-03-01 10:00+00'),
    (v_a, tests.fx('rj_1002'), tests.fx('rm_tech2_a'),   '2025-03-01 10:00:01+00'),
    (v_a, tests.fx('rj_1003'), tests.fx('rm_tech1_a'),   '2025-03-01 10:00+00'),
    (v_a, tests.fx('rj_1003'), tests.fx('rm_tech2_a'),   '2025-03-01 10:00:01+00'),
    (v_a, tests.fx('rj_1003'), tests.fx('rm_manager_a'), '2025-03-01 10:00:02+00'),
    (v_a, tests.fx('rj_1004'), tests.fx('rm_tech2_a'),   '2025-03-01 10:00+00'),
    (v_a, tests.fx('rj_1005'), tests.fx('rm_tech1_a'),   '2025-03-01 10:00+00'),
    (v_a, tests.fx('rj_1007'), tests.fx('rm_tech1_a'),   '2025-03-01 10:00+00');

  -- ------------------------------------------------------------ quotes (numbers 1001..1005)
  insert into public.quotes (shop_id, customer_id, status, valid_until, sent_at)
    values (v_a, tests.fx('rc_alice'), 'sent', null, '2025-03-01 12:00+00') returning id into v_id;
  perform tests.fx_set('rq_1001', v_id);
  insert into public.quotes (shop_id, customer_id, status, valid_until, sent_at, viewed_at)
    values (v_a, tests.fx('rc_bob'), 'viewed', '2025-03-04', '2025-02-20 12:00+00', '2025-02-21 12:00+00') returning id into v_id;
  perform tests.fx_set('rq_1002', v_id);
  insert into public.quotes (shop_id, customer_id, status, valid_until, sent_at, viewed_at)
    values (v_a, tests.fx('rc_ann'), 'viewed', '2025-03-05', '2025-02-26 12:00+00', '2025-02-27 12:00+00') returning id into v_id;
  perform tests.fx_set('rq_1003', v_id);
  insert into public.quotes (shop_id, customer_id, status)
    values (v_a, tests.fx('rc_bob'), 'draft') returning id into v_id;
  perform tests.fx_set('rq_1004', v_id);
  insert into public.quotes (shop_id, customer_id, status, sent_at, approved_at, approved_by_name)
    values (v_a, tests.fx('rc_alice'), 'approved', '2025-02-01 12:00+00', '2025-02-02 12:00+00', 'Alice') returning id into v_id;
  perform tests.fx_set('rq_1005', v_id);

  -- ------------------------------------------------------------ invoices (numbers 1001..1009)
  insert into public.invoices (shop_id, job_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rj_1001'), tests.fx('rc_alice'), 'open', '2025-02-20 18:30+00', '2025-02-20 18:30+00')
    returning id into v_id;
  perform tests.fx_set('ri_1001', v_id);
  insert into public.invoices (shop_id, job_id, customer_id, status, issued_at, due_at, discount_kind, discount_value)
    values (v_a, tests.fx('rj_1002'), tests.fx('rc_alice'), 'open', '2025-03-03 20:30+00', '2025-03-03 20:30+00', 'fixed', 2900)
    returning id into v_id;
  perform tests.fx_set('ri_1002', v_id);
  insert into public.invoices (shop_id, job_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rj_1003'), tests.fx('rc_bob'), 'open', '2025-03-05 02:00+00', '2025-03-19 02:00+00')
    returning id into v_id;
  perform tests.fx_set('ri_1003', v_id);
  insert into public.invoices (shop_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rc_ann'), 'open', '2024-12-01 18:00+00', '2024-12-15 18:00+00') returning id into v_id;
  perform tests.fx_set('ri_1004', v_id);
  insert into public.invoices (shop_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rc_bob'), 'open', '2024-10-01 17:00+00', '2024-10-31 17:00+00') returning id into v_id;
  perform tests.fx_set('ri_1005', v_id);
  insert into public.invoices (shop_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rc_alice'), 'open', '2025-01-20 18:00+00', '2025-02-03 18:00+00') returning id into v_id;
  perform tests.fx_set('ri_1006', v_id);
  insert into public.invoices (shop_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rc_alice'), 'open', '2025-01-19 18:00+00', '2025-02-02 18:00+00') returning id into v_id;
  perform tests.fx_set('ri_1007', v_id);
  insert into public.invoices (shop_id, customer_id, status)
    values (v_a, tests.fx('rc_bob'), 'draft') returning id into v_id;
  perform tests.fx_set('ri_1008', v_id);
  insert into public.invoices (shop_id, customer_id, status, issued_at, due_at)
    values (v_a, tests.fx('rc_ann'), 'open', '2025-02-25 18:00+00', '2025-02-25 18:00+00') returning id into v_void;
  perform tests.fx_set('ri_1009', v_void);

  insert into public.invoice_line_items (shop_id, invoice_id, service_id, name, quantity, unit_price_cents, taxable, sort) values
    (v_a, tests.fx('ri_1001'), tests.fx('rs_full'),    'Full Detail',            1,  20000, true,  0),
    (v_a, tests.fx('ri_1002'), tests.fx('rs_full'),    'Full Detail',            1,  20000, true,  0),
    (v_a, tests.fx('ri_1002'), tests.fx('rs_pet'),     'Pet Hair Removal',       1,   5000, false, 1),
    (v_a, tests.fx('ri_1002'), null,                   'Headlight Polish',       2,   1500, true,  2),
    (v_a, tests.fx('ri_1003'), tests.fx('rs_ceramic'), 'Ceramic Coating',        1, 100000, true,  0),
    (v_a, tests.fx('ri_1004'), null,                   'Headlight Restoration',  1,  15000, true,  0),
    (v_a, tests.fx('ri_1005'), null,                   'Fleet Wash Package',     1,  30000, false, 0),
    (v_a, tests.fx('ri_1006'), null,                   'Interior Shampoo',       1,   7500, false, 0),
    (v_a, tests.fx('ri_1007'), null,                   'Wheel Cleaning',         1,   4000, false, 0),
    (v_a, tests.fx('ri_1008'), null,                   'Engine Bay',             1,   9000, false, 0),
    (v_a, tests.fx('ri_1009'), null,                   'Odor Removal',           1,  12345, false, 0);
  update public.invoices set status = 'void', voided_at = '2025-03-01 12:00+00', void_reason = 'Duplicate'
   where id = v_void;

  -- ------------------------------------------------------------ payments
  insert into public.payments (shop_id, invoice_id, kind, method, status, amount_cents, tip_cents, refunded_cents,
                               stripe_payment_intent_id, paid_at) values
    (v_a, tests.fx('ri_1001'), 'payment', 'card', 'succeeded', 21600, 2000, 0, 'pi_rep1', '2025-02-20 19:00+00'),
    (v_a, tests.fx('ri_1002'), 'deposit', 'cash', 'succeeded',  5000,    0, 0, null,      '2025-03-01 05:30+00'),
